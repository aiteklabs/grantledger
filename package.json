{
  "name": "grantledger",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "schema:json": "pnpm --filter @grantledger/schema build:json",
    "sample": "pnpm --filter @grantledger/ingest sample",
    "dev": "pnpm --filter @grantledger/ingest dev",
    "deploy:ingest": "pnpm --filter @grantledger/ingest run release"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.2.0",
    "@types/node": "^24.19.2",
    "oxlint": "^1.95.0",
    "tsrs": "7.1.0-beta.tsrs5"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.28.0 <7.29.1": "7.29.1"
    }
  }
}
