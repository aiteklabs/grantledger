---
import { env } from "cloudflare:workers";
import Base from "~/layouts/Base.astro";
import { POSTS, getPost, postPath } from "~/lib/blog";
import { fmtDate } from "~/lib/format";

// The frame of a guide: title, dates, the body from the page, the standing notice and the other guides.
interface Props { slug: string }
const post = getPost(Astro.props.slug);
const url = env.SITE_URL + postPath(post);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  datePublished: post.published,
  dateModified: post.checked,
  inLanguage: "en",
  url,
  mainEntityOfPage: url,
  author: { "@type": "Organization", name: "Aitek Labs", url: "https://aiteklabs.com" },
  publisher: { "@type": "Organization", name: "GrantLedger", url: env.SITE_URL },
};
const others = POSTS.filter((p) => p.slug !== post.slug);
---
<Base title={post.title} description={post.description} jsonLd={jsonLd}>
  <div class="wrap" style="padding-top:3rem;max-width:820px">
    <article>
      <span class="kicker"><a href="/blog" style="color:inherit;text-decoration:none">Guides</a> · {post.kicker}</span>
      <h1 style="font-size:clamp(2rem,4.5vw,3.2rem)">{post.title}</h1>
      <p class="small muted">Published {fmtDate(post.published)}. Facts checked against the official sources on {fmtDate(post.checked)}.</p>
      <slot />
      <p class="callout small" style="margin-top:2.5rem">This guide explains a public scheme in plain English. It is not legal, tax or financial advice. Rules, amounts and dates change: the official page linked under Sources is the authority, and you apply there or through the body it names. Found an error? <a href="https://github.com/aiteklabs/grantledger/issues/new" rel="noopener">Tell us</a>.</p>
    </article>
    <h2 style="margin-top:2.5rem">More guides</h2>
    <ul>{others.map((p) => <li><a href={postPath(p)}>{p.title}</a></li>)}</ul>
    <p><a class="btn ghost" href="/grants">Search the ledger</a></p>
  </div>
</Base>
<style>
  article :global(h2) { margin-top: 2.4rem; }
  article :global(table) { margin: 1rem 0; }
</style>
