---
import { env } from "cloudflare:workers";
import Base from "~/layouts/Base.astro";
import { aiNotice } from "~/i18n/pages/ai-notice";
export const prerender = false;
const c = aiNotice[Astro.locals.locale] ?? aiNotice.en;
---
<Base title={c.metaTitle} description={c.metaDescription}>
  <div class="wrap" style="padding-top:3rem;max-width:820px">
    <span class="kicker">{c.kicker}</span>
    <h1 style="font-size:clamp(2rem,4.5vw,3.2rem)">{c.title}</h1>
    <p class="lead">{c.lead}</p>
    <h2>{c.whereTitle}</h2>
    <ul>
      <li><b>{c.prefillBold}</b> {c.prefillRest.replace("{model}", env.GEMINI_MODEL)}</li>
      <li><b>{c.enrichBold}</b> {c.enrichRest}</li>
    </ul>
    <h2>{c.noneTitle}</h2>
    <ul>
      {c.noneItems.map((item) => <li>{item}</li>)}
    </ul>
    <h2>{c.wrongTitle}</h2>
    <p>{c.wrongBody}</p>
    <h2>{c.dataTitle}</h2>
    <p>{c.dataBody}</p>
    <h2>{c.providersTitle}</h2>
    <p>{c.providersBody}</p>
  </div>
</Base>
