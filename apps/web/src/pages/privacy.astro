---
import { env } from "cloudflare:workers";
import Base from "~/layouts/Base.astro";
import { privacy } from "~/i18n/pages/privacy";
export const prerender = false;
const c = privacy[Astro.locals.locale] ?? privacy.en;
---
<Base title={c.metaTitle} description={c.metaDescription}>
  <div class="wrap" style="padding-top:3rem;max-width:820px">
    <span class="kicker">{c.kicker}</span>
    <h1 style="font-size:clamp(2rem,4.5vw,3.2rem)">{c.title}</h1>
    <p class="lead">{c.lead}</p>

    <h2>{c.whoTitle}</h2>
    <p>{c.whoOperates} <a href="mailto:contact@aiteklabs.com">contact@aiteklabs.com</a>. {c.whoDetails.before} <a href="/legal-notice">{c.whoDetails.link}</a>{c.whoDetails.after}</p>

    <h2>{c.browsingTitle}</h2>
    <ul>
      <li>{c.browsingCookies}</li>
      <li>{c.browsingAnalytics}</li>
      <li>{c.browsingLogs.before} <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener">{c.browsingLogs.link}</a>{c.browsingLogs.after}</li>
    </ul>

    <h2>{c.fitTitle}</h2>
    <p>{c.fitIntro}</p>
    <ul>
      {c.fitItems.map((item) => <li>{item}</li>)}
    </ul>
    <p>{c.fitPrivate}</p>
    <p>{c.fitPrefill.before} <a href="/ai-notice">{c.fitPrefill.link}</a>{c.fitPrefill.after}</p>
    <p>{c.fitTurnstile}</p>

    <h2>{c.proTitle}</h2>
    <p>{c.proAccount.before} <a href="https://stripe.com/privacy" rel="noopener">{c.proAccount.link}</a>{c.proAccount.after}</p>

    <h2>{c.whereTitle}</h2>
    <p>{c.whereBody}</p>

    <h2>{c.retentionTitle}</h2>
    <p>{c.retentionBody}</p>

    <h2>{c.rightsTitle}</h2>
    <p>{c.rights.before} <a href="mailto:contact@aiteklabs.com">contact@aiteklabs.com</a>{c.rights.after}</p>

    <h2>{c.ledgerTitle}</h2>
    <p>{c.ledgerBody}</p>

    <h2>{c.changesTitle}</h2>
    <p>{c.changes.before.replace("{model}", env.GEMINI_MODEL)} <a href="https://github.com/aiteklabs/grantledger" rel="noopener">{c.changes.link}</a>{c.changes.after}</p>
  </div>
</Base>
