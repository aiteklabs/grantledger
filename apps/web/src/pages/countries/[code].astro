---
import { env } from "cloudflare:workers";
import Base from "~/layouts/Base.astro";
import GrantRow from "~/components/GrantRow.astro";
import { searchGrants } from "~/lib/db";
import { COUNTRY_NAMES, SOURCE_NAMES, countryName, fmtInt } from "~/lib/format";
import { localePath, t } from "~/i18n";
export const prerender = false;

// One landing page per country, in every locale: the open calls and the official feeds behind them.
const locale = Astro.locals.locale;
const d = t(locale);
const code = (Astro.params.code ?? "").toUpperCase();
if (!/^[A-Z]{2}$/.test(code) || !COUNTRY_NAMES[code]) return new Response("Not found", { status: 404 });
const L = (href: string) => localePath(locale, href);
const now = new Date().toISOString();
const [result, feeds] = await Promise.all([
  searchGrants(env.DB, { country: code, status: "open", sort: "deadline", pageSize: 50 }),
  env.DB.prepare("SELECT source, COUNT(*) AS n FROM grants WHERE country = ? AND status IN ('open','forthcoming') AND (closes_at IS NULL OR closes_at >= ?) GROUP BY source ORDER BY n DESC").bind(code, now).all<{ source: string; n: number }>(),
]);
if (result.total === 0 && feeds.results.length === 0) return new Response("Not found", { status: 404 });
const name = countryName(code, locale);
const sources = feeds.results.map((f) => (SOURCE_NAMES[f.source] ?? f.source).replace(new RegExp(`^${COUNTRY_NAMES[code]} `), "")).join(", ");
const fill = (s: string) => s.replace("{country}", name).replace("{n}", fmtInt(result.total)).replace("{sources}", sources);
const title = fill(d.country_title);
const lead = fill(d.country_lead);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description: lead,
  url: new URL(L(`/countries/${code.toLowerCase()}`), env.SITE_URL).href,
  isPartOf: { "@type": "WebSite", name: "grantledger", url: env.SITE_URL },
  about: { "@type": "Country", name },
};
---
<Base title={title} description={lead} jsonLd={jsonLd}>
  <div class="wrap" style="padding-top:3rem">
    <span class="kicker"><a href={L("/countries")} style="color:inherit;text-decoration:none">{d.nav_countries}</a> · {name}</span>
    <h1 style="font-size:clamp(2rem,4.5vw,3.2rem)">{title}</h1>
    <p class="lead">{lead}</p>
    {code !== "EU" && <p class="callout small">{fill(d.country_eu_note)} <a href={L("/countries/eu")}>{countryName("EU", locale)}</a>.</p>}
    <h2 style="margin-top:2rem">{fill(d.country_open_calls)}</h2>
    <ul class="ledger">{result.items.map((g) => <GrantRow grant={g} locale={locale} />)}</ul>
    {result.total > result.items.length && <p style="margin-top:1.5rem"><a class="btn ghost" href={L(`/grants?country=${code}&status=open`)}>{fill(d.country_all)} ({fmtInt(result.total)})</a></p>}
    {feeds.results.length > 0 && (
      <>
        <h2 style="margin-top:2.5rem">{d.stat_sources}</h2>
        <ul>{feeds.results.map((f) => <li><a href={L(`/grants?source=${f.source}&country=${code}`)}>{SOURCE_NAMES[f.source] ?? f.source}</a> · {fmtInt(f.n)}</li>)}</ul>
        <p class="small muted"><a href="/coverage">Coverage</a></p>
      </>
    )}
  </div>
</Base>
