---
import { env } from "cloudflare:workers";
import Base from "~/layouts/Base.astro";
import { consumeMagicLink, safeNext, sessionCookie } from "~/lib/account";
import { t } from "~/i18n";
export const prerender = false;

// GET /auth?token=...: the magic link. Sets the session cookie and sends the account to its profiles, or back to
// the assistant connection it was in the middle of (the gl_next cookie set by /oauth/authorize).
const d = t(Astro.locals.locale);
const token = Astro.url.searchParams.get("token") ?? "";
const resume = Astro.cookies.get("gl_next")?.value;
const next = safeNext(resume || Astro.url.searchParams.get("next"));
const email = await consumeMagicLink(env.DB, token);
if (email) {
  const headers = new Headers({ location: next, "set-cookie": await sessionCookie(env, email) });
  if (resume) headers.append("set-cookie", "gl_next=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax");
  return new Response(null, { status: 303, headers });
}
---
<Base title={d.login_title} noindex={true}>
  <div class="wrap" style="padding-top:3rem;max-width:720px">
    <span class="kicker">{d.login_title}</span>
    <h1 style="font-size:clamp(2rem,4.5vw,3.2rem)">{d.auth_expired_title}</h1>
    <p class="lead">{d.auth_expired_text}</p>
    <p><a class="btn" href="/login">{d.auth_new}</a></p>
  </div>
</Base>
