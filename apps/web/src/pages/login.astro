---
import { env } from "cloudflare:workers";
import Base from "~/layouts/Base.astro";
import { currentAccount } from "~/lib/account";
import { t } from "~/i18n";
export const prerender = false;

const d = t(Astro.locals.locale);
const account = await currentAccount(Astro.request, env);
if (account) return Astro.redirect("/me", 303);
const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error") ?? "";
const next = Astro.url.searchParams.get("next") ?? "";
const turnstile = env.TURNSTILE_SITE_KEY;
---
<Base title={d.login_title} noindex={true}>
  {turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <div class="wrap" style="padding-top:3rem;max-width:720px">
    <span class="kicker">Pro</span>
    <h1 style="font-size:clamp(2rem,4.5vw,3.2rem)">{d.login_title}</h1>
    {sent ? (
      <p class="callout" style="border-left-color:var(--moss)">{d.login_sent}</p>
    ) : (
      <>
        <p class="lead">{d.login_lead}</p>
        {error === "email" && <p class="callout">{d.pro_bad_email}</p>}
        {error === "captcha" && <p class="callout">{d.login_captcha}</p>}
        <form method="post" action="/api/login" class="form" style="max-width:480px">
          <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" required autocomplete="email" /></div>
          <input type="hidden" name="next" value={next} />
          {turnstile && <div class="cf-turnstile" data-sitekey={turnstile} data-theme="auto"></div>}
          <div><button class="btn" type="submit">{d.login_send}</button></div>
        </form>
        <p class="small muted" style="margin-top:1.5rem"><a href="/pro">{d.login_noaccount}</a></p>
      </>
    )}
  </div>
</Base>
