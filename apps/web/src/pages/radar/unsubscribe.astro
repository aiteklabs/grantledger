---
import { env } from "cloudflare:workers";
import Base from "~/layouts/Base.astro";
export const prerender = false;

// The link in the email footer. The id is a 36-hex random token only the emails carry. GET only shows a button and
// the POST of that button stops the Radar: mail scanners open every link in a message (see auth.astro), and a stop
// on GET let them remove the profile before its owner read the email. The oldest profiles carry a 24-hex
// id.
const id = Astro.url.searchParams.get("id") ?? "";
const valid = /^[0-9a-f]{24,36}$/.test(id);
const post = Astro.request.method === "POST";
const ok = post && valid ? (await env.DB.prepare("UPDATE radars SET active = 0 WHERE id = ?").bind(id).run()).meta.changes > 0 : false;
const ask = !post && valid && !!(await env.DB.prepare("SELECT 1 FROM radars WHERE id = ? AND active = 1").bind(id).first());
---
<Base title="Radar stopped" noindex={true}>
  <div class="wrap" style="padding-top:3rem;max-width:720px">
    <span class="kicker">Radar</span>
    {ask ? (
      <>
        <h1 style="font-size:clamp(2rem,4.5vw,3.2rem)">Stop this Radar?</h1>
        <p class="lead">The weekly emails for this profile stop and the profile leaves your account. Your screening page stays live.</p>
        <form method="post"><button class="btn" type="submit">Stop emails for this profile</button></form>
      </>
    ) : (
      <>
        <h1 style="font-size:clamp(2rem,4.5vw,3.2rem)">{ok ? "Radar stopped." : "Nothing to stop."}</h1>
        <p class="lead">{ok ? "No more emails for this profile. Your screening page stays live, and you can write to contact@aiteklabs.com to switch Radar back on at no cost." : "This link does not match an active Radar. It may already be stopped."}</p>
        <p><a class="btn ghost" href="/">Back to the ledger</a></p>
      </>
    )}
  </div>
</Base>
