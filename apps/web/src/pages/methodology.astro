  it_con_il_sud: "Fondazione Con il Sud public call information (fondazioneconilsud.it)",
  be_kbs: "King Baudouin Foundation public call information (kbs-frb.be)",
  be_fnrs: "F.R.S.-FNRS public funding information (frs-fnrs.be)",
